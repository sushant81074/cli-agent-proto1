    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@openrouter/sdk": "^1.3.8",
    "commander": "^15.0.0",
    "dotenv": "^18.0.1",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.8.0",
    "zod": "^4.6.5"
